# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# Postgres connection string (Neon pooled endpoint works).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret Better Auth uses to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Sends sign-up verification codes and password-reset links.
RESEND_API_KEY=

# --- Optional (defaults shown) ----------------------------------------------

# HTTP and Socket.IO port.
# PORT=3000

# Public URL of this server, used as Better Auth's base URL.
# BACKEND_URL=http://localhost:3000

# App origins. Password-reset links fall back to the player app.
# ADMIN_APP_URL=http://localhost:5173
# PLAYER_APP_URL=http://localhost:5174

# Comma-separated origins allowed to call the API and open a socket with
# cookies. Defaults to ADMIN_APP_URL and PLAYER_APP_URL.
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Direct (non "-pooler") Neon endpoint for the pool that runs trading writes.
# Defaults to DATABASE_URL.
# TRADING_DATABASE_URL=

# Set to false to stop the engine writing OHLC candles to the database.
# ENABLE_STOCK_DB_UPDATES=true

# API key for the Better Auth dashboard plugin.
# BETTER_AUTH_API_KEY=
